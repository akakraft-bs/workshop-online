<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11: Nichts sichern. Zugangsdaten sind an den Keystore des Geräts gebunden,
     der Offline-Cache wird ohnehin neu geladen. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
