<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: weder Cloud-Backup noch Geräteübertragung. Zugangsdaten sind an den
     Keystore des Geräts gebunden, der Offline-Cache wird ohnehin neu geladen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
